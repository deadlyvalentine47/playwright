# Non-secret configuration for CI. Committed on purpose.
#
# Secret values are NEVER in this file. CI injects them as environment variables
# from the pipeline's secret store; dotenv does not override variables that are
# already set in the environment, so the injected value wins over anything here.

BLOGSPOT_BASE_URL=https://testautomationpractice.blogspot.com/
BOLT_BASE_URL=https://bolt.playrealbrokerage.com

WORKERS=2
RETRIES=2

BOLT_AUTH_STATE=.auth/bolt.json
