[
  {
    "testName": "opens the calendar with a full month of days",
    "action": "open",
    "expectedMonthPattern": "^[A-Z][a-z]+ \\d{4}$",
    "minimumDaysInMonth": 28
  },
  {
    "testName": "advances to the next month",
    "action": "nextMonth",
    "expectMonthChange": true
  },
  {
    "testName": "selecting a day writes a date into the input",
    "action": "selectDay",
    "day": 15,
    "expectedValuePattern": "^\\d{2}\\/15\\/\\d{4}$"
  }
]
