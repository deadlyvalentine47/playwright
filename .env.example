# Key manifest. Copy to a local env file and fill in real values.
#
#   cp .env.example .env.qa      # gitignored, your own copy
#   npm run test:qa
#
# CI does NOT read these files. Each GitHub Environment (qa / stage / prod) holds
# its own values, injected as environment variables, which override anything in a
# local file. See .github/workflows/playwright.yml.

# ---- Identity ----------------------------------------------------------------
# Which environment this run is targeting. Used by the tripwire assertion that
# catches "stage build running QA config".
APP_ENV=qa

# ---- Targets -----------------------------------------------------------------
# Internal hostnames belong in the pipeline's environment secrets, not in git.
BLOGSPOT_BASE_URL=
BOLT_BASE_URL=

# ---- Execution ---------------------------------------------------------------
# WORKERS  default 4 locally / 1 in CI
# RETRIES  default 0 locally / 2 in CI
WORKERS=4
RETRIES=0

# ---- Session state -----------------------------------------------------------
# Each environment keeps its own cached session.
BOLT_AUTH_STATE=.auth/bolt.qa.json
