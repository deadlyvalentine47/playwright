# Copy to .env.<environment> and fill in every value.
# The framework reads ENV_FILE to choose which file to load:
#
#   npm run test         -> ENV_FILE=.env
#   npm run test:qa      -> ENV_FILE=.env.qa
#   npm run test:stage   -> ENV_FILE=.env.stage
#
# Only values that genuinely differ per environment belong here.

# ---- Targets -----------------------------------------------------------------
BLOGSPOT_BASE_URL=https://testautomationpractice.blogspot.com/
BOLT_BASE_URL=https://bolt.playrealbrokerage.com

# ---- Execution ---------------------------------------------------------------
# WORKERS  default 4 locally / 1 in CI
# RETRIES  default 0 locally / 2 in CI
WORKERS=4
RETRIES=0

# ---- Session state -----------------------------------------------------------
# Each environment keeps its own cached session.
BOLT_AUTH_STATE=.auth/bolt.json
