# Key manifest. Copy to .env and fill in real values.
#
#   cp .env.example .env        # .env is gitignored
#   npm test
#
# CI does NOT read this file. Each GitHub Environment (qa / stage / prod) holds
# its own values, injected as environment variables, which override anything here.
# See .github/workflows/playwright.yml.

# ---- Targets -----------------------------------------------------------------
# Optional locally — playwright.config.ts falls back to the public defaults.
# Required in CI: the config throws if they are missing while CI=true.
BLOGSPOT_BASE_URL=https://testautomationpractice.blogspot.com/
BOLT_BASE_URL=https://bolt.playrealbrokerage.com
SAUCE_DEMO_URL=https://www.saucedemo.com

# ---- Execution ---------------------------------------------------------------
# WORKERS  default 4 locally / 1 in CI
# RETRIES  default 0 locally / 2 in CI
WORKERS=4
RETRIES=0

# ---- Session state -----------------------------------------------------------
# Where bolt-auth writes the logged-in session and the bolt project reads it from.
BOLT_AUTH_STATE=.auth/bolt.json
