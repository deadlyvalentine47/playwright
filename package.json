{
  "name": "playwright-automation",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:blogspot": "playwright test --project=blogspot",
    "test:bolt": "playwright test --project=bolt",
    "test:repeat": "playwright test --repeat-each=3",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report reports",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run typecheck && npm run lint && npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Playwright end-to-end automation framework",
  "devDependencies": {
    "@eslint/css": "^0.10.0",
    "@eslint/js": "^9.31.0",
    "@eslint/json": "^0.13.1",
    "@eslint/markdown": "^7.1.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "playwright": "^1.65.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
